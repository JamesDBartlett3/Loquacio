<UserControl x:Class="WhisperDictation.Views.OutputTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="12">
    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
        <Label Content="Output Mode" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding OutputModes}"
                  SelectedItem="{Binding OutputMode}"
                  Width="200" HorizontalAlignment="Left"
                  Margin="0,0,0,4"/>
        <TextBlock Text="inject = type into the focused window (default) · clipboard = copy only · type = synthetic keystrokes"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,16"
                   TextWrapping="Wrap"/>

        <CheckBox Content="Show toast notifications" IsChecked="{Binding ToastEnabled}"
                  Margin="0,0,0,4"/>
        <TextBlock Text="Show a desktop notification when a transcription completes."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
    </StackPanel>
</UserControl>
