<UserControl x:Class="WhisperDictation.Views.AudioTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:WhisperDictation.Controls"
             Padding="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left column: input device, gain, gate thresholds, level meter -->
        <StackPanel Grid.Column="0">
            <Label Content="Input Device" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <ComboBox ItemsSource="{Binding AvailableDevices}"
                      DisplayMemberPath="FriendlyName"
                      SelectedItem="{Binding SelectedDevice}"
                      Margin="0,0,0,12"/>

            <Label Content="Gain" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Slider Minimum="0.1" Maximum="5.0" Value="{Binding Gain}"
                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,4"/>
            <TextBlock Text="{Binding Gain, StringFormat='{}{0:F1}x'}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <Label Content="Silence Threshold (ms)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Slider Minimum="500" Maximum="5000" Value="{Binding SilenceThresholdMs}"
                    TickFrequency="100" IsSnapToTickEnabled="True"
                    Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SilenceThresholdMs, StringFormat='{}{0:0} ms'}" HorizontalAlignment="Center" Margin="0,0,0,4"/>

            <Label Content="Silence Threshold (dB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Slider Minimum="-60" Maximum="0" Value="{Binding SilenceThresholdDb}"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,0,0,4"/>
            <TextBlock Text="{Binding SilenceThresholdDb, StringFormat='{}{0:0} dB'}" HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <controls:VUMeterControl Level="{Binding CurrentAudioLevel}" PeakLevel="{Binding PeakAudioLevel}"
                                     SilenceThresholdDb="{Binding SilenceThresholdDb}"
                                     CompressorThresholdDb="{Binding CompressorThresholdDb}"
                                     Height="20" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding CurrentAudioLevelDb, StringFormat='Current level: {0}'}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding PeakAudioLevelDb, StringFormat='5-second peak: {0}'}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11"/>
        </StackPanel>

        <!-- Right column: compressor -->
        <StackPanel Grid.Column="2">
            <Label Content="Dynamic Range Compression" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <CheckBox Content="Enable dynamic range compression" IsChecked="{Binding CompressorEnabled}"
                      Margin="0,0,0,12"/>

            <Label Content="Compressor Threshold (dB)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Slider Minimum="-40" Maximum="0" Value="{Binding CompressorThresholdDb}"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding CompressorEnabled}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CompressorThresholdDb, StringFormat='{}{0:0} dB'}"
                       HorizontalAlignment="Center" Margin="0,0,0,12"/>

            <Label Content="Compressor Ratio" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <Slider Minimum="1" Maximum="20" Value="{Binding CompressorRatio}"
                    TickFrequency="1" IsSnapToTickEnabled="True"
                    IsEnabled="{Binding CompressorEnabled}" Margin="0,0,0,4"/>
            <TextBlock Text="{Binding CompressorRatio, StringFormat='{}{0:0}:1'}"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
