<UserControl x:Class="WhisperDictation.Views.WhisperTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="12">
    <StackPanel>
        <Label Content="Model Size" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <ComboBox ItemsSource="{Binding ModelSizes}"
                      SelectedItem="{Binding SelectedModelSize}"
                      Width="150" Margin="0,0,8,0"/>
            <Button Content="Download" Command="{Binding DownloadModelCommand}"
                    IsEnabled="{Binding IsDownloading, Converter={StaticResource InvertBool}}"
                    Padding="12,4" Margin="0,0,4,0"/>
            <Button Content="Cancel" Command="{Binding CancelDownloadCommand}"
                    Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"
                    Padding="8,4" Margin="0,0,4,0"/>
            <Button Content="Delete" Command="{Binding DeleteModelCommand}"
                    Visibility="{Binding CanDeleteSelectedModel, Converter={StaticResource BoolToVis}}"
                    ToolTip="Remove this downloaded model from disk (the model currently in use cannot be deleted)"
                    Padding="8,4"/>
        </StackPanel>

        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                     Height="8" Margin="0,0,0,4"
                     Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>

        <TextBlock Text="{Binding DownloadStatus}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,12"/>

        <Label Content="Language" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <ComboBox ItemsSource="{Binding Languages}"
                  SelectedItem="{Binding Language}"
                  Margin="0,0,0,12"/>

        <Label Content="Model Path" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <TextBox Text="{Binding ModelPath}" IsReadOnly="True" Margin="0,0,0,12"/>
    </StackPanel>
</UserControl>
