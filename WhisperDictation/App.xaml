<Application x:Class="WhisperDictation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WhisperDictation.Converters"
             ThemeMode="System"
             Startup="OnStartup"
             Exit="OnExit">
    <Application.Resources>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToStartStopConverter x:Key="BoolToStartStop"/>
        <conv:BoolToStartStopConverter x:Key="BoolToStartStopConverter"/>
        <conv:BoolToCaptureConverter x:Key="BoolToCapture"/>

        <!-- Small circular "i" info icon; put the tooltip text in Tag -->
        <Style x:Key="InfoIconStyle" TargetType="Control">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Control">
                        <Border Width="16" Height="16" CornerRadius="8"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1" VerticalAlignment="Center"
                                ToolTipService.InitialShowDelay="100"
                                ToolTip="{TemplateBinding Tag}">
                            <TextBlock Text="i" FontSize="10" FontStyle="Italic" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
