<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>loquacio-tui</AssemblyName>
    <RootNamespace>Loquacio.Tui</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Sockets" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Loquacio.Models" />
    <Using Include="Loquacio.Services" />
    <Using Include="Loquacio.Ipc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loquacio.Core\Loquacio.Core.csproj" />
  </ItemGroup>

</Project>
