[Unit]
Description=Loquacio Daemon (local voice-to-text)
Documentation=https://elitedesk.local:3001/Innovation/loquacio
After=pipewire.service pipewire.socket
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/lib/loquacio/loquacio-daemon
Restart=on-failure
RestartSec=3
Environment=DOTNET_GCHeapHardLimit=1C0000000

[Install]
WantedBy=default.target
