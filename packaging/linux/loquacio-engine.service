[Unit]
Description=Loquacio Engine (local voice-to-text)
Documentation=https://github.com/JamesDBartlett3/Loquacio
After=pipewire.service pipewire.socket
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/lib/loquacio/loquacio-engine
Restart=on-failure
RestartSec=3
Environment=DOTNET_GCHeapHardLimit=1C0000000

[Install]
WantedBy=default.target
