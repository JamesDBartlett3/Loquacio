<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>loquacio-avalonia</AssemblyName>
    <RootNamespace>Loquacio.Avalonia</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- XAML in this project was written for reflection bindings (Avalonia 11 style);
         Avalonia 12 defaults to compiled bindings with no reflection fallback, which
         produces AVLN2100/AVLN2000 errors across existing views. Keep reflection
         bindings until views are migrated deliberately. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Sockets" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Loquacio.Models" />
    <Using Include="Loquacio.Services" />
    <Using Include="Loquacio.Ipc" />
    <Using Include="CommunityToolkit.Mvvm.ComponentModel" />
    <Using Include="CommunityToolkit.Mvvm.Input" />
    <Using Include="Avalonia" />
    <Using Include="Avalonia.Controls" />
    <Using Include="Avalonia.Layout" />
    <Using Include="Avalonia.Media" />
    <Using Include="Avalonia.Threading" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <!-- Tmds.DBus.Protocol 0.9x line (CVE-2026-39959 / GHSA-xrw6-gwf8-vvr9 fix shipped
         in 0.92.0; 0.21.3 was the patched 0.2x backport). Avalonia 12.x is compiled
         against the 0.9x API (Connection -> DBusConnection), so the long-standing
         0.21.3 compat pin is no longer needed and we track the fixed line directly. -->
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.95.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\loquacio-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loquacio.Core\Loquacio.Core.csproj" />
    <ProjectReference Include="..\Loquacio.Shared\Loquacio.Shared.csproj" />
  </ItemGroup>

</Project>
