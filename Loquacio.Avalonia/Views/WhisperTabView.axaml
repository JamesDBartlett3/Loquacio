<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Loquacio.Avalonia.Views.WhisperTabView">
    <StackPanel Spacing="16" MaxWidth="500">

        <StackPanel Spacing="6">
            <TextBlock Text="Model Size" FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding AvailableModels}" SelectedItem="{Binding ModelSize}" />
            <TextBlock Text="Larger models are more accurate but slower."
                       FontSize="11" Foreground="#6c7086" />
        </StackPanel>

        <Separator />

        <StackPanel Spacing="6">
            <TextBlock Text="Language" FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
            <TextBlock Text="'auto' detects the spoken language automatically."
                       FontSize="11" Foreground="#6c7086" />
        </StackPanel>

        <Separator />

        <StackPanel Spacing="6">
            <TextBlock Text="Model Path" FontWeight="SemiBold" FontSize="13" />
            <TextBox Text="{Binding ModelPath}" Watermark="Path to .ggml model file"
                     IsReadOnly="True" />
            <TextBlock Text="Models are managed by the engine."
                       FontSize="11" Foreground="#6c7086" />
        </StackPanel>

    </StackPanel>
</UserControl>
