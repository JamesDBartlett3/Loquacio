<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Loquacio.Avalonia.ViewModels"
        xmlns:views="using:Loquacio.Avalonia.Views"
        x:Class="Loquacio.Avalonia.Views.MainWindow"
        Title="Loquacio — Avalonia Controller"
        Width="800" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterScreen">

    <Design.DataContext>
        <vm:ControllerViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header / Status Bar -->
        <Border Grid.Row="0" Background="#1e1e2e" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="🎙️" FontSize="24" VerticalAlignment="Center" />
                    <TextBlock Text="Loquacio" FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="#cdd6f4" />
                    <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="8,2">
                        <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="12" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#313244" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding ConnectionStatus}" FontSize="11" Foreground="#a6adc8" />
                    </Border>
                    <Ellipse Width="10" Height="10">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding IsConnected, Converter={x:Static views:BoolToBrushConverter.Instance}}" />
                        </Ellipse.Fill>
                    </Ellipse>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Padding="8">

            <!-- Dashboard Tab -->
            <TabItem Header="Dashboard">
                <Grid RowDefinitions="Auto,Auto,*" Margin="12">

                    <!-- Status + Controls -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                        <Button Content="{Binding IsListening, Converter={x:Static views:ListenButtonTextConverter.Instance}}"
                                Command="{Binding ToggleListeningCommand}"
                                IsEnabled="{Binding IsConnected}"
                                Padding="20,8" FontSize="14" />
                        <Button Content="Cycle Mode" Command="{Binding CycleModeCommand}"
                                IsEnabled="{Binding IsConnected}"
                                Padding="12,8" />
                        <Button Content="Reconnect" Command="{Binding ReconnectCommand}"
                                IsEnabled="{Binding !IsConnected}"
                                Padding="12,8" />
                    </StackPanel>

                    <!-- Current State -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,12">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Mode" Foreground="#a6adc8" FontSize="11" />
                            <TextBlock Text="{Binding CurrentMode}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Audio Level" Foreground="#a6adc8" FontSize="11" />
                            <views:VuMeterControl Value="{Binding AudioLevel}" Width="200" Height="20" />
                        </StackPanel>
                    </Grid>

                    <!-- Transcription History -->
                    <Grid Grid.Row="2" RowDefinitions="Auto,*">
                        <DockPanel Grid.Row="0" Margin="0,0,0,6">
                            <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}"
                                    DockPanel.Dock="Right" Padding="8,2" FontSize="11" />
                            <TextBlock Text="Recent Transcriptions" FontSize="14" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="#181825" CornerRadius="6" Padding="8">
                            <ListBox ItemsSource="{Binding TranscriptionHistory}" Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                       Foreground="#a6adc8" FontSize="11"
                                                       VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                       MaxWidth="500" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- General Settings Tab -->
            <TabItem Header="General">
                <views:GeneralTabView DataContext="{Binding General}" Margin="12" />
            </TabItem>

            <!-- Audio Tab -->
            <TabItem Header="Audio">
                <views:AudioTabView DataContext="{Binding Audio}" Margin="12" />
            </TabItem>

            <!-- Whisper Tab -->
            <TabItem Header="Whisper">
                <views:WhisperTabView DataContext="{Binding Whisper}" Margin="12" />
            </TabItem>

            <!-- LLM Tab -->
            <TabItem Header="LLM">
                <views:LLMTabView DataContext="{Binding LLM}" Margin="12" />
            </TabItem>

            <!-- Vocabulary Tab -->
            <TabItem Header="Vocabulary">
                <views:VocabularyTabView DataContext="{Binding Vocabulary}" Margin="12" />
            </TabItem>

        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1e1e2e" Padding="16,6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Engine IPC • Unix Domain Socket" FontSize="11"
                           Foreground="#6c7086" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding EngineStateText}" FontSize="11"
                           Foreground="#6c7086" />
            </Grid>
        </Border>

    </Grid>
</Window>
