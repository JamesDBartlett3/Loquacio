<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Loquacio.Avalonia.Views.VocabularyTabView">
    <StackPanel Spacing="16" MaxWidth="500">

        <StackPanel Spacing="6">
            <TextBlock Text="Custom Vocabulary" FontWeight="SemiBold" FontSize="13" />
            <TextBlock Text="Words here are included in LLM correction prompts for better accuracy with domain-specific terms."
                       FontSize="11" Foreground="#6c7086" TextWrapping="Wrap" />
        </StackPanel>

        <Separator />

        <!-- Add word -->
        <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBox Text="{Binding NewWord}" Watermark="Enter a word…"
                     Width="250" />
            <Button Content="Add" Command="{Binding AddWordCommand}" />
        </StackPanel>

        <!-- Word list -->
        <Border Background="#181825" CornerRadius="6" Padding="4" MinHeight="100">
            <ItemsControl ItemsSource="{Binding CustomWords}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto" Margin="4,2">
                            <TextBlock Text="{Binding}" Grid.Column="0" VerticalAlignment="Center" />
                            <Button Content="✕" Grid.Column="1" Padding="4,2" FontSize="10"
                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveWordCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

    </StackPanel>
</UserControl>
