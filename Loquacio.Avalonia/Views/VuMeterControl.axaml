<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Loquacio.Avalonia.Views.VuMeterControl">
    <Grid>
        <Border Background="#313244" CornerRadius="3" Height="16" />
        <Border Name="FillBar" Background="#22c55e" CornerRadius="3" Height="16"
                HorizontalAlignment="Left" />
        <Border Name="PeakBar" Background="#f59e0b" Width="2" Height="16"
                HorizontalAlignment="Left" />
    </Grid>
</UserControl>
