<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WhisperDictation.Avalonia.ViewModels"
             x:Class="WhisperDictation.Avalonia.Views.GeneralTabView">
    <StackPanel Spacing="16" MaxWidth="500">

        <!-- Activation Mode -->
        <StackPanel Spacing="6">
            <TextBlock Text="Activation Mode" FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding ActivationMode}" />
            <Expander Header="ℹ️ Mode Info" IsExpanded="False" Margin="0,2,0,0">
                <StackPanel Spacing="4">
                    <TextBlock Text="Continuous: Always listening, processes on silence pause. Hands-free dictation."
                               FontSize="11" Foreground="#a6adc8" TextWrapping="Wrap" />
                    <TextBlock Text="Push-to-Talk: Hold hotkey to record, release to process. Precise, no background noise."
                               FontSize="11" Foreground="#a6adc8" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
        </StackPanel>

        <Separator />

        <!-- Hotkeys -->
        <StackPanel Spacing="6">
            <TextBlock Text="Hotkeys" FontWeight="SemiBold" FontSize="13" />

            <!-- Configurable toggle hotkey -->
            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="Toggle Listening" Grid.Column="0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                    <Border Background="#313244" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="{Binding HotkeyDisplay}"
                                   FontFamily="Cascadia Code,monospace" Foreground="#89b4fa" />
                    </Border>
                    <Button Content="✎" Padding="4,2" Command="{Binding StartRecordingHotkeyCommand}" />
                </StackPanel>
            </Grid>

            <!-- Hotkey recording indicator -->
            <Border Background="#f59e0b" CornerRadius="4" Padding="8,4"
                    IsVisible="{Binding IsRecordingHotkey}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="⌨️ Press the desired key combination…" FontSize="11" />
                    <Button Content="Cancel" Command="{Binding CancelHotkeyRecordingCommand}"
                            Padding="4,2" FontSize="10" />
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                <TextBlock Text="Cycle Mode" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToggleModeHotkey}" Grid.Column="1"
                           FontFamily="Cascadia Code,monospace" Foreground="#89b4fa" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Stop" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding StopHotkey}" Grid.Column="1"
                           FontFamily="Cascadia Code,monospace" Foreground="#89b4fa" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Copy Last Output" Grid.Column="0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CopyLastOutputHotkey}" Grid.Column="1"
                           FontFamily="Cascadia Code,monospace" Foreground="#89b4fa" />
            </Grid>
        </StackPanel>

        <Separator />

        <!-- Output -->
        <StackPanel Spacing="6">
            <TextBlock Text="Output" FontWeight="SemiBold" FontSize="13" />
            <Grid ColumnDefinitions="Auto,*">
                <TextBlock Text="Output Mode" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding OutputMode}"
                          Grid.Column="1" />
            </Grid>
            <CheckBox Content="Show notifications" IsChecked="{Binding NotificationsEnabled}" />
        </StackPanel>

    </StackPanel>
</UserControl>
