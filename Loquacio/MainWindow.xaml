<Window x:Class="Loquacio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Loquacio.ViewModels"
        xmlns:views="clr-namespace:Loquacio.Views"
        xmlns:controls="clr-namespace:Loquacio.Controls"
        xmlns:conv="clr-namespace:Loquacio.Converters"
        Title="Loquacio"
        Height="680" Width="1000" MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
        TextElement.FontSize="13"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <Window.Resources>
        <conv:BoolToStartStopConverter x:Key="BoolToStartStop"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InvertBoolConverter x:Key="InvertBool"/>
        <conv:IndexEqualsToVisibilityConverter x:Key="IndexEqualsVis"/>

        <!-- Card: rounded, elevated surface used for dashboard content groups -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <!-- Section heading inside cards -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- Sidebar navigation item. Uses the same accent brushes as the rest of
             the app (e.g. the mode switch thumb) instead of the Fluent theme's
             ListBoxItemSelected* brushes, which don't track the system accent. -->
        <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Border" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background"
                                        Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Two-way mode switch: both labels always visible; the thumb slides
             under the active one (Continuous off / Push-to-Talk on) -->
        <Style x:Key="ModeSwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Track" CornerRadius="15"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb" Width="106" Height="24" CornerRadius="12"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            <Grid Margin="3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="OffLabel" Grid.Column="0" Text="Continuous"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="OnLabel" Grid.Column="1" Text="Push-to-Talk"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="OffLabel" Property="Foreground"
                                        Value="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <Setter TargetName="OnLabel" Property="Foreground"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush"
                                        Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── Header: status, audio level, primary actions ── -->
        <Border Grid.Row="0" Padding="20,12,20,12"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,1,10,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ConnectionStatus, StringFormat=' ·  {0}'}" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" Margin="2,1,0,0"/>
                    <Border Padding="10,3" CornerRadius="10" Margin="16,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <TextBlock Text="{Binding CurrentMode}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Border>
                </StackPanel>

                <controls:VUMeterControl Grid.Column="1" Level="{Binding AudioLevel}" PeakLevel="{Binding PeakAudioLevel}"
                                         Width="180" Height="16" VerticalAlignment="Center" Margin="16,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding IsListening, Converter={StaticResource BoolToStartStop}}"
                            Command="{Binding ToggleListeningCommand}"
                            IsEnabled="{Binding IsConnected}"
                            MinWidth="128" MinHeight="34" Padding="16,4" FontSize="14" FontWeight="SemiBold"
                            Margin="0,0,8,0"/>
                    <Button Content="Reconnect"
                            Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InvertBool}}"
                            MinHeight="34" Padding="14,4" FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Body: sidebar navigation + content panel ── -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="232"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox x:Name="NavList" SelectedIndex="0" Margin="10,12,10,12"
                     BorderThickness="0" Background="Transparent"
                     ItemContainerStyle="{StaticResource NavItemStyle}">
                <ListBoxItem Content="Dashboard"/>
                <ListBoxItem Content="Input"/>
                <ListBoxItem Content="Output"/>
                <ListBoxItem Content="Whisper"/>
                <ListBoxItem Content="Activation &amp; Hotkeys"/>
                <ListBoxItem Content="Custom Dictionary"/>
                <ListBoxItem Content="LLM Post-Processing"/>
                <ListBoxItem Content="App Theme &amp; Behavior"/>
            </ListBox>

            <Border Grid.Column="1" Width="1"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}"/>

            <Grid Grid.Column="2" Margin="20,16,20,12">

                <!-- 0 · Dashboard -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=0}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- No-model warning banner -->
                        <Border Margin="0,0,0,12" Padding="14,10" CornerRadius="8"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}"
                                BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="1"
                                Visibility="{Binding NoModelConfigured, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"
                                           Foreground="{DynamicResource SystemFillColorAttentionBrush}"/>
                                <TextBlock Text="No Whisper model configured — dictation is disabled until a model is downloaded."
                                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="480"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                <Button Content="Open Whisper Settings…" Click="OnOpenWhisperSettings"
                                        MinHeight="28" Padding="12,2" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Session card -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Session" Style="{StaticResource SectionHeaderStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Background Service" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding EngineStateText}" Margin="8,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton Style="{StaticResource ModeSwitchStyle}"
                                                      IsChecked="{Binding IsPushToTalk}"
                                                      IsEnabled="{Binding IsConnected}"
                                                      AutomationProperties.AutomationId="ModeSwitch"
                                                      ToolTip="Continuous: listens continuously and types automatically at each pause. Push-to-Talk: press the hotkey to start and again to stop."
                                                      Margin="0,0,8,0"/>
                                        <Button Content="Restart Background Service" Command="{Binding RestartEngineCommand}"
                                                MinHeight="32" Padding="14,4"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Last transcription card -->
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Last Transcription" Style="{StaticResource SectionHeaderStyle}"/>
                                <TextBox Text="{Binding LastTranscription}" IsReadOnly="True"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="52" MaxHeight="110"
                                         VerticalScrollBarVisibility="Auto"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- History card -->
                        <Border Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Recent Transcriptions" Style="{StaticResource SectionHeaderStyle}"/>
                                <ListBox Grid.Row="1" ItemsSource="{Binding TranscriptionHistory}"
                                         MinHeight="160" BorderThickness="0" Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                           FontSize="12" VerticalAlignment="Top" Margin="0,2,14,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1 · Input (audio device, gain, gate, level meter) -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=1}"
                              VerticalScrollBarVisibility="Auto">
                    <views:AudioTab DataContext="{Binding AudioSettings}" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 2 · Output -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=2}"
                              VerticalScrollBarVisibility="Auto">
                    <views:OutputTab DataContext="{Binding ActivationSettings}" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 3 · Whisper -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=3}"
                              VerticalScrollBarVisibility="Auto">
                    <views:WhisperTab DataContext="{Binding WhisperSettings}" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 4 · Activation & Hotkeys -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=4}"
                              VerticalScrollBarVisibility="Auto">
                    <views:GeneralTab DataContext="{Binding ActivationSettings}" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 5 · Custom Dictionary -->
                <Grid Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=5}">
                    <views:VocabularyTab DataContext="{Binding VocabularySettings}" MaxWidth="720" HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- 6 · LLM Post-Processing -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=6}"
                              VerticalScrollBarVisibility="Auto">
                    <views:LLMTab DataContext="{Binding LlmSettings}" MaxWidth="720" HorizontalAlignment="Left"/>
                </ScrollViewer>

                <!-- 7 · App Theme & Behavior -->
                <ScrollViewer Visibility="{Binding SelectedIndex, ElementName=NavList, Converter={StaticResource IndexEqualsVis}, ConverterParameter=7}"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource SectionHeaderStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Theme" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeModeOptions}"
                                              SelectedItem="{Binding ThemeMode}" Width="140"/>
                                </Grid>
                                <TextBlock Text="System follows your Windows light/dark setting. Changes apply immediately."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Window Behavior" Style="{StaticResource SectionHeaderStyle}"/>
                                <CheckBox Content="Minimize to tray (hide when minimized)" IsChecked="{Binding MinimizeToTray}" Margin="0,3"
                                          ToolTip="Hide to system tray when the window is minimized"/>
                                <CheckBox Content="Close to tray (keep running when closed)" IsChecked="{Binding CloseToTray}" Margin="0,3"
                                          ToolTip="Hide to system tray instead of exiting when the window is closed"/>
                                <CheckBox Content="Start minimized to tray" IsChecked="{Binding StartMinimized}" Margin="0,3"
                                          ToolTip="Launch the app hidden in the system tray"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Background Service" Style="{StaticResource SectionHeaderStyle}"/>
                                <CheckBox Content="Run the background service automatically when needed" IsChecked="{Binding AutoStartEngine}" Margin="0,3"
                                          ToolTip="Launch the background service automatically when the controller starts"/>
                                <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,3"
                                          ToolTip="Launch Loquacio automatically when you log into Windows"/>
                                <TextBlock Text="Audio and Whisper settings are managed by the background service."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12"
                                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ── Footer ── (removed — no useful information for the user) -->
    </Grid>
</Window>
