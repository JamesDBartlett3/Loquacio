<UserControl x:Class="Loquacio.Views.GeneralTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="12">
    <StackPanel>
        <!-- Activation mode has a single control: the Continuous / Push-to-Talk
             switch on the Dashboard. -->
        <TextBlock Text="Activation mode is controlled by the switch on the Dashboard."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Margin="0,0,0,12"/>

        <!-- Hotkey Configuration -->
        <Label Content="Hotkeys" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="4" Margin="0,0,0,12">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Toggle Listening (editable) -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Toggle Listening" VerticalAlignment="Center" Margin="0,2"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="HotkeyBox" Text="{Binding Hotkey}" Width="120" Margin="4,2"
                             IsReadOnly="True" IsUndoEnabled="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="{Binding IsCapturingToggle, Converter={StaticResource BoolToCapture}}"
                            Command="{Binding StartCaptureCommand}" CommandParameter="toggle"
                            Click="HotkeyCaptureButton_Click" Tag="HotkeyBox"
                            Width="80" Margin="4,2"/>
                    <Button Content="Clear" Command="{Binding ClearHotkeyCommand}" CommandParameter="toggle"
                            ToolTip="Clear this hotkey and un-bind it"
                            Width="52" Margin="0,2,4,2"/>
                </StackPanel>

                <!-- Toggle Mode (editable) -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Toggle Mode (Continuous ↔ PTT)" VerticalAlignment="Center" Margin="0,2"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="ToggleModeBox" Text="{Binding ToggleModeHotkey}" Width="120" Margin="4,2"
                             IsReadOnly="True" IsUndoEnabled="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="{Binding IsCapturingToggleMode, Converter={StaticResource BoolToCapture}}"
                            Command="{Binding StartCaptureCommand}" CommandParameter="mode"
                            Click="HotkeyCaptureButton_Click" Tag="ToggleModeBox"
                            Width="80" Margin="4,2"/>
                    <Button Content="Clear" Command="{Binding ClearHotkeyCommand}" CommandParameter="mode"
                            ToolTip="Clear this hotkey and un-bind it"
                            Width="52" Margin="0,2,4,2"/>
                </StackPanel>

                <!-- Stop (editable) -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Stop Listening" VerticalAlignment="Center" Margin="0,2"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="StopBox" Text="{Binding StopHotkey}" Width="120" Margin="4,2"
                             IsReadOnly="True" IsUndoEnabled="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="{Binding IsCapturingStop, Converter={StaticResource BoolToCapture}}"
                            Command="{Binding StartCaptureCommand}" CommandParameter="stop"
                            Click="HotkeyCaptureButton_Click" Tag="StopBox"
                            Width="80" Margin="4,2"/>
                    <Button Content="Clear" Command="{Binding ClearHotkeyCommand}" CommandParameter="stop"
                            ToolTip="Clear this hotkey and un-bind it"
                            Width="52" Margin="0,2,4,2"/>
                </StackPanel>

                <!-- Copy Last Output (editable) -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Copy Last Output" VerticalAlignment="Center" Margin="0,2"/>
                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="CopyBox" Text="{Binding CopyLastOutputHotkey}" Width="120" Margin="4,2"
                             IsReadOnly="True" IsUndoEnabled="False"
                             PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                    <Button Content="{Binding IsCapturingCopy, Converter={StaticResource BoolToCapture}}"
                            Command="{Binding StartCaptureCommand}" CommandParameter="copy"
                            Click="HotkeyCaptureButton_Click" Tag="CopyBox"
                            Width="80" Margin="4,2"/>
                    <Button Content="Clear" Command="{Binding ClearHotkeyCommand}" CommandParameter="copy"
                            ToolTip="Clear this hotkey and un-bind it"
                            Width="52" Margin="0,2,4,2"/>
                </StackPanel>

                <!-- Status -->
                <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding StatusMessage}" Foreground="DodgerBlue"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <TextBlock Text="Changes are applied automatically. The background service reports hotkeys already in use by other applications in its log."
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" Margin="0,0,0,4"
                   TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
