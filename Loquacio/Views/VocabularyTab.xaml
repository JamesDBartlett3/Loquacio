<UserControl x:Class="Loquacio.Views.VocabularyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Padding="12">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox Text="{Binding NewWord, UpdateSourceTrigger=PropertyChanged}"
                     Width="250" Margin="0,0,8,0">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding AddWordCommand}"/>
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Add" Command="{Binding AddWordCommand}" Padding="12,4"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding CustomWords}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <Button Content="✕" DockPanel.Dock="Right" Margin="4,0,0,0"
                                Command="{Binding DataContext.RemoveWordCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                Padding="4,1" FontSize="10"/>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
