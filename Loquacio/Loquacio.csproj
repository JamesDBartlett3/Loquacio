<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WPF0001: Application/Window.ThemeMode (Fluent dark/light/system) is the official
         Fluent theme mechanism; still marked experimental in .NET 10 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>..\Assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading" />
    <Using Include="System.Threading.Tasks" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="Loquacio.Models" />
    <Using Include="Loquacio.Ipc" />
    <Using Include="Loquacio.Services" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\tray_icon.ico" />
    <Resource Include="Resources\tray_icon_idle.ico" />
    <Resource Include="Resources\tray_icon_listening.ico" />
    <Resource Include="Resources\tray_icon_processing.ico" />
    <Resource Include="Resources\tray_icon_error.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Loquacio.Core\Loquacio.Core.csproj" />
    <ProjectReference Include="..\Loquacio.Shared\Loquacio.Shared.csproj" />
    <ProjectReference Include="..\Loquacio.Engine\Loquacio.Engine.csproj" />
  </ItemGroup>

</Project>
